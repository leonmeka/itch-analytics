{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "declaration": false,
    "outDir": "../../dist",
    "rootDir": "../..",
    "baseUrl": ".",
    "sourceMap": false,
    "incremental": false,
    "paths": {
      "@/api/*": ["./src/*"],
      "@itch/protocol": ["../../libs/protocol/src"],
      "@/libs/auth": ["../../libs/auth/src"],
      "@/libs/auth/*": ["../../libs/auth/src/*"],
      "@/libs/itch": ["../../libs/itch/src"],
      "@/libs/itch/*": ["../../libs/itch/src/*"],
      "@/libs/shared": ["../../libs/shared/src"],
      "@/libs/shared/*": ["../../libs/shared/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test", "**/*spec.ts"]
}
