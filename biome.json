{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!!**/dist/**",
      "!!**/coverage/**",
      "!!**/node_modules/**",
      "!!apps/api/src/@generated/**",
      "!!libs/shared/src/db/migrations/**",
      "!!apps/mobile/global.css",
      "!!apps/mobile/assets/**/*.svg"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noImportantStyles": "off"
      },
      "style": {
        "useImportType": "off"
      },
      "suspicious": {
        "noExplicitAny": "off"
      }
    }
  },
  "javascript": {
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    },
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "overrides": [
    {
      "includes": ["apps/mobile/global.css", "apps/mobile/**/*.svg"],
      "linter": { "enabled": false },
      "formatter": { "enabled": false }
    }
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
