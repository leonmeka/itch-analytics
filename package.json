{
  "name": "itch",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=11.8.0 <12.0.0"
  },
  "scripts": {
    "dev": "docker compose up --build --wait",
    "db:migrate": "pnpm --filter @itch/shared run migrate",
    "db:apply": "pnpm --filter @itch/shared run apply",
    "db:studio": "pnpm --filter @itch/shared run studio",
    "mobile": "dotenv -e .env -- pnpm --filter @itch/mobile run start",
    "mobile:ios": "dotenv -e .env -- pnpm --filter @itch/mobile run run:ios",
    "mobile:android": "dotenv -e .env -- pnpm --filter @itch/mobile run run:android",
    "lint": "biome lint --write apps libs",
    "format": "biome format --write apps libs"
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.2.5",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.5",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.5",
    "@nestjs/swagger": "^11.0.0",
    "axios": "^1.20.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "drizzle-orm": "^0.45.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "passport": "^0.7.0",
    "passport-strategy": "^1.0.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.3",
    "@types/passport": "^1.0.17",
    "@types/passport-strategy": "^0.2.38",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "express": "^5.2.1",
    "sharp": "^0.35.4",
    "typescript": "^5.9.3"
  }
}
